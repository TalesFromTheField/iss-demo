  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "monitoring",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "environmentName": {
            "value": "[variables('normalizedEnvironmentName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.42.1.51946",
              "templateHash": "3139035333357774440"
            }
          },
          "parameters": {
            "environmentName": {
              "type": "string",
              "metadata": {
                "description": "Environment name used for resource naming (e.g. dev, staging, prod)."
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "Azure region for all resources in this module."
              }
            },
            "functionAppName": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Name of the Function App (informational; for backward compatibility)."
              }
            },
            "functionAppResourceId": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Resource ID of the Function App (for backward compatibility; used in alert display names)."
              }
            },
            "containerAppName": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Name of the Container App (informational; used in alert display names)."
              }
            },
            "containerAppResourceId": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Resource ID of the Container App to scope metric alerts against. When empty, alert rules are not deployed."
              }
            }
          },
          "variables": {
            "normalizedEnvironmentName": "[toLower(replace(replace(replace(parameters('environmentName'), ' ', '-'), '_', '-'), '.', '-'))]",
            "logAnalyticsName": "[format('law-iss-{0}', variables('normalizedEnvironmentName'))]",
            "appInsightsName": "[format('appi-iss-{0}', variables('normalizedEnvironmentName'))]",
            "effectiveAppResourceId": "[if(not(empty(parameters('containerAppResourceId'))), parameters('containerAppResourceId'), parameters('functionAppResourceId'))]",
            "effectiveAppName": "[if(not(empty(parameters('containerAppName'))), parameters('containerAppName'), parameters('functionAppName'))]",
            "alertsEnabled": "[not(empty(variables('effectiveAppResourceId')))]"
