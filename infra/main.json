  },
  "variables": {
    "normalizedEnvironmentName": "[toLower(replace(replace(replace(parameters('environmentName'), ' ', '-'), '_', '-'), '.', '-'))]",
    "bootstrapEnabled": "[and(and(and(not(empty(parameters('fabricTenantId'))), not(empty(parameters('fabricClientId')))), not(empty(parameters('fabricClientSecret')))), not(empty(parameters('fabricWorkspaceId'))))]",
    "effectiveImageUri": "[if(not(empty(parameters('containerImageUri'))), parameters('containerImageUri'), 'ghcr.io/talesfromthefield/iss-demo:latest')]"
