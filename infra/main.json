            "fabricClientId": {
              "type": "string",
              "metadata": {
                "description": "Application (client) ID of the service principal granted access to the Fabric workspace."
              }
            },
            "fabricClientSecret": {
              "type": "securestring",
              "metadata": {
                "description": "Client secret of the service principal. Store this value in a Key Vault in production."
              }
            },
            "deployFabricScriptUrl": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "  Optional URL override for deploy-fabric.sh. Leave blank to use the script\nfrom the main branch of the TalesFromTheField/iss-demo repository.\n"
              }
            }
          },
          "variables": {
            "$fxv#0": "#!/bin/bash\r\n# =============================================================================\r\n# ISS Demo — Fabric Bootstrap Script\r\n#\r\n# Runs inside an Azure deploymentScript (managed ACI) as part of 'azd up' or\r\n# the Deploy to Azure flow. Performs all Fabric setup automatically:\r\n#\r\n#   1. Installs ms-fabric-cli\r\n#   2. Authenticates with Fabric using a service principal\r\n#   3. Creates Eventhouse, KQL Database, and tables (idempotent)\r\n#   4. Captures the FabricIngestionUri from the deployment output\r\n#   5. Updates the Container App with FabricIngestionUri so it can start\r\n#      streaming data to Fabric immediately\r\n#\r\n# Environment variables (injected by Bicep deploymentScript):\r\n#   FABRIC_CLIENT_ID       — Service principal application (client) ID\r\n#   FABRIC_CLIENT_SECRET   — Service principal client secret (secure)\r\n#   FABRIC_TENANT_ID       — Azure / Entra tenant ID\r\n#   FABRIC_WORKSPACE_ID    — Fabric workspace GUID\r\n#   CONTAINER_APP_NAME     — Name of the Azure Container App to update\r\n#   AZURE_RESOURCE_GROUP   — Resource group containing the Container App\r\n#   DEPLOY_FABRIC_SCRIPT   — URL of deploy-fabric.sh to download (optional override)\r\n#\r\n# Output (written to $AZ_SCRIPTS_OUTPUT_PATH):\r\n#   { \"fabricIngestionUri\": \"https://trd-xxx.region.kusto.data.microsoft.com\" }\r\n# =============================================================================\r\n\r\nset -euo pipefail\r\n\r\nRED='\\033[0;31m'; GREEN='\\033[0;32m'; YELLOW='\\033[1;33m'; CYAN='\\033[0;36m'; NC='\\033[0m'\r\ninfo()  { echo -e \"${CYAN}[INFO]${NC}  $*\"; }\r\nok()    { echo -e \"${GREEN}[OK]${NC}    $*\"; }\r\nwarn()  { echo -e \"${YELLOW}[WARN]${NC}  $*\"; }\r\nerr()   { echo -e \"${RED}[ERROR]${NC} $*\" >&2; }\r\n\r\n# -- Validate required env vars -----------------------------------------------\r\n\r\nfor var in FABRIC_CLIENT_ID FABRIC_CLIENT_SECRET FABRIC_TENANT_ID FABRIC_WORKSPACE_ID \\\r\n           CONTAINER_APP_NAME AZURE_RESOURCE_GROUP; do\r\n    if [[ -z \"${!var:-}\" ]]; then\r\n        err \"Missing required environment variable: $var\"\r\n        exit 1\r\n    fi\r\ndone\r\n\r\n# -- Install ms-fabric-cli ----------------------------------------------------\r\n\r\ninfo \"Installing ms-fabric-cli...\"\r\npip install -q --disable-pip-version-check ms-fabric-cli\r\nok \"ms-fabric-cli installed: $(fab --version 2>/dev/null || echo 'unknown')\"\r\n\r\n# -- Authenticate with Fabric -------------------------------------------------\r\n\r\ninfo \"Authenticating with Fabric (service principal)...\"\r\nfab auth login \\\r\n    -u \"$FABRIC_CLIENT_ID\" \\\r\n    -p \"$FABRIC_CLIENT_SECRET\" \\\r\n    --tenant \"$FABRIC_TENANT_ID\"\r\nok \"Fabric authenticated\"\r\n\r\n# -- Download and run deploy-fabric.sh ----------------------------------------\r\n\r\nSCRIPT_URL=\"${DEPLOY_FABRIC_SCRIPT:-https://raw.githubusercontent.com/TalesFromTheField/iss-demo/main/scripts/deploy-fabric.sh}\"\r\ninfo \"Downloading deploy-fabric.sh from: $SCRIPT_URL\"\r\ncurl -fsSL \"$SCRIPT_URL\" -o /tmp/deploy-fabric.sh\r\nchmod +x /tmp/deploy-fabric.sh\r\nok \"Script downloaded\"\r\n\r\ninfo \"Running Fabric deployment for workspace: $FABRIC_WORKSPACE_ID\"\r\nDEPLOY_OUTPUT=$(/tmp/deploy-fabric.sh --workspace-id \"$FABRIC_WORKSPACE_ID\" 2>&1) || {\r\n    err \"deploy-fabric.sh failed. Output:\"\r\n    echo \"$DEPLOY_OUTPUT\"\r\n    exit 1\r\n}\r\n\r\necho \"$DEPLOY_OUTPUT\"\r\n\r\n# -- Extract FabricIngestionUri -----------------------------------------------\r\n\r\nFABRIC_URI=$(echo \"$DEPLOY_OUTPUT\" | grep \"FabricIngestionUri = \" | awk '{print $NF}' | tail -1)\r\n\r\nif [[ -z \"$FABRIC_URI\" ]]; then\r\n    warn \"Could not extract FabricIngestionUri from deployment output.\"\r\n    warn \"You can set it manually:\"\r\n    warn \"  az containerapp update --name $CONTAINER_APP_NAME --resource-group $AZURE_RESOURCE_GROUP --set-env-vars FabricIngestionUri=<uri>\"\r\n    # Write empty output so deploymentScript does not fail\r\n    echo '{\"fabricIngestionUri\":\"\"}' > \"${AZ_SCRIPTS_OUTPUT_PATH:-/dev/null}\"\r\n    exit 0\r\nfi\r\n\r\nok \"FabricIngestionUri: $FABRIC_URI\"\r\n\r\n# -- Update Container App env var ---------------------------------------------\r\n\r\ninfo \"Updating Container App '$CONTAINER_APP_NAME' with FabricIngestionUri...\"\r\naz containerapp update \\\r\n    --name \"$CONTAINER_APP_NAME\" \\\r\n    --resource-group \"$AZURE_RESOURCE_GROUP\" \\\r\n    --set-env-vars \"FabricIngestionUri=$FABRIC_URI\" \\\r\n    --output none\r\nok \"Container App updated — ISS Demo is now streaming to Fabric\"\r\n\r\n# -- Write outputs ------------------------------------------------------------\r\n\r\necho \"{\\\"fabricIngestionUri\\\": \\\"$FABRIC_URI\\\"}\" > \"${AZ_SCRIPTS_OUTPUT_PATH:-/dev/null}\"\r\ninfo \"Bootstrap complete.\"\r\n"
          },
          "resources": [
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "apiVersion": "2023-01-31",
              "name": "uami-bootstrap-iss",
              "location": "[parameters('location')]"
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceGroup().id, resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'uami-bootstrap-iss'), 'contributor-bootstrap')]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b24988ac-6180-42a0-ab88-20f7382dd24c')]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'uami-bootstrap-iss'), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'uami-bootstrap-iss')]"
              ]
            },
            {
              "type": "Microsoft.Resources/deploymentScripts",
              "apiVersion": "2023-08-01",
              "name": "bootstrap-fabric",
              "location": "[parameters('location')]",
              "kind": "AzureCLI",
              "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                  "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'uami-bootstrap-iss'))]": {}
                }
              },
              "properties": {
                "azCliVersion": "2.59.0",
                "timeout": "PT30M",
                "retentionInterval": "PT1H",
                "cleanupPreference": "OnSuccess",
                "environmentVariables": [
                  {
                    "name": "FABRIC_CLIENT_ID",
                    "value": "[parameters('fabricClientId')]"
                  },
                  {
                    "name": "FABRIC_CLIENT_SECRET",
                    "secureValue": "[parameters('fabricClientSecret')]"
                  },
                  {
                    "name": "FABRIC_TENANT_ID",
                    "value": "[parameters('fabricTenantId')]"
                  },
                  {
                    "name": "FABRIC_WORKSPACE_ID",
                    "value": "[parameters('fabricWorkspaceId')]"
                  },
                  {
                    "name": "CONTAINER_APP_NAME",
                    "value": "[parameters('containerAppName')]"
                  },
                  {
                    "name": "AZURE_RESOURCE_GROUP",
                    "value": "[parameters('resourceGroupName')]"
                  },
                  {
                    "name": "DEPLOY_FABRIC_SCRIPT",
                    "value": "[parameters('deployFabricScriptUrl')]"
                  }
                ],
                "scriptContent": "[variables('$fxv#0')]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'uami-bootstrap-iss')]",
                "[resourceId('Microsoft.Authorization/roleAssignments', guid(resourceGroup().id, resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'uami-bootstrap-iss'), 'contributor-bootstrap'))]"
              ]
            }
          ],
          "outputs": {
            "fabricIngestionUri": {
              "type": "string",
              "metadata": {
                "description": "Fabric Ingestion URI detected and applied to the Container App by the bootstrap script."
              },
              "value": "[coalesce(reference(resourceId('Microsoft.Resources/deploymentScripts', 'bootstrap-fabric'), '2023-08-01').outputs.fabricIngestionUri, '')]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'container-app')]",
        "[resourceId('Microsoft.Resources/deployments', 'role-assignments')]"
      ]
    }
  ],
  "outputs": {
    "containerAppName": {
      "type": "string",
      "metadata": {
        "description": "Name of the deployed Container App."
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'container-app'), '2025-04-01').outputs.containerAppName.value]"
    },
    "containerImageUri": {
      "type": "string",
      "metadata": {
        "description": "Container image URI deployed."
      },
      "value": "[variables('effectiveImageUri')]"
    },
    "acrLoginServer": {
      "type": "string",
      "metadata": {
        "description": "Container Registry login server."
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'container-registry'), '2025-04-01').outputs.loginServer.value]"
    },
    "fabricIngestionUri": {
      "type": "string",
      "metadata": {
        "description": "Fabric Ingestion URI applied to the Container App (only set when bootstrap ran)."
      },
      "value": "[if(variables('bootstrapEnabled'), reference(resourceId('Microsoft.Resources/deployments', 'bootstrap'), '2025-04-01').outputs.fabricIngestionUri.value, parameters('fabricIngestionUri'))]"
    }
  }
}