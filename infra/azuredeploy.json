{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "14412801038583032324"
    }
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "metadata": {
        "description": "Environment name (e.g., dev, staging, prod)."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "containerImageUri": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional container image URI override. Leave blank to deploy ghcr.io/talesfromthefield/iss-demo:latest."
      }
    },
    "fabricIngestionUri": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Eventhouse Query URI from the Fabric portal (e.g. https://trd-xxxx.z6.kusto.data.microsoft.com). Leave blank when bootstrap is enabled — the bootstrap container sets this automatically."
      }
    },
    "fabricDatabaseName": {
      "type": "string",
      "defaultValue": "iss-demo-kqldb",
      "metadata": {
        "description": "Fabric KQL Database name to ingest data into."
      }
    },
    "fabricTenantId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "  Entra tenant ID for Fabric app registration authentication.\nWhen provided together with fabricClientId and fabricClientSecret, the\ndeployment automatically provisions all Fabric resources and configures the\nContainer App — no manual steps required.\nLeave blank to configure Fabric manually after deployment.\n"
      }
    },
    "fabricClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Application (client) ID of the app registration used for Fabric access."
      }
    },
    "fabricClientSecret": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Client secret of the app registration. This value is never logged or stored in plain text."
      }
    },
    "fabricWorkspaceName": {
      "type": "string",
      "defaultValue": "iss-demo",
      "metadata": {
        "description": "Display name for the Fabric workspace to create (e.g., \"iss-demo\"). The bootstrap will create it."
      }
    },
    "adminEmail": {
      "type": "string",
      "metadata": {
        "description": "Email address of the user or group to grant Admin access to the Fabric workspace. Required so a human can access and manage the workspace after bootstrap."
      }
    },
    "deployPbiReport": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Set to true to automatically deploy the Power BI report from PBI/ISS.pbix during bootstrap."
      }
    }
  },
  "variables": {
    "normalizedEnvironmentName": "[toLower(replace(replace(replace(parameters('environmentName'), ' ', '-'), '_', '-'), '.', '-'))]",
    "bootstrapEnabled": "[and(and(not(empty(parameters('fabricTenantId'))), not(empty(parameters('fabricClientId')))), not(empty(parameters('fabricClientSecret'))))]",
    "effectiveImageUri": "[if(not(empty(parameters('containerImageUri'))), parameters('containerImageUri'), 'ghcr.io/talesfromthefield/iss-demo:latest')]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "monitoring",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "environmentName": {
            "value": "[variables('normalizedEnvironmentName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.42.1.51946",
              "templateHash": "3139035333357774440"
            }
          },
          "parameters": {
            "environmentName": {
              "type": "string",
              "metadata": {
                "description": "Environment name used for resource naming (e.g. dev, staging, prod)."
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "Azure region for all resources in this module."
              }
            },
            "functionAppName": {
              "type": "string",
