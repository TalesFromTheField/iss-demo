              }
            },
            "resourceGroupName": {
              "type": "string",
              "defaultValue": "[resourceGroup().name]",
              "metadata": {
                "description": "Name of the Container App resource group."
              }
            },
            "fabricWorkspaceName": {
              "type": "string",
              "defaultValue": "iss-demo",
              "metadata": {
                "description": "Display name for the Fabric workspace to create (e.g., \"iss-demo\")."
              }
            },
            "fabricTenantId": {
              "type": "string",
              "metadata": {
                "description": "Entra tenant ID for Fabric app registration authentication."
              }
            },
            "fabricClientId": {
              "type": "string",
              "metadata": {
                "description": "Application (client) ID of the app registration used for Fabric access."
              }
            },
            "fabricClientSecret": {
              "type": "securestring",
              "metadata": {
                "description": "Client secret of the app registration. Store this value in a Key Vault in production."
              }
            },
            "adminEmail": {
              "type": "string",
              "metadata": {
                "description": "Email address of the user or group to grant Admin access to the created Fabric workspace. Required so a human can access and manage the workspace after bootstrap."
              }
            },
            "deployPbiReport": {
              "type": "bool",
              "defaultValue": false,
              "metadata": {
                "description": "Set to true to automatically deploy the Power BI report from PBI/ISS.pbix."
              }
            },
            "deployFabricScriptUrl": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Optional URL override for deploy-fabric.sh. Leave blank to use the script from the main branch of the TalesFromTheField/iss-demo repository."
              }
            },
            "bootstrapImageUri": {
              "type": "string",
              "defaultValue": "ghcr.io/talesfromthefield/iss-demo-bootstrap:latest",
              "metadata": {
                "description": "Bootstrap container image URI. Defaults to the latest image from GHCR."
              }
            },
            "subscriptionId": {
              "type": "string",
              "defaultValue": "[subscription().subscriptionId]",
              "metadata": {
                "description": "Azure subscription ID — passed to the container so az account set works correctly."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "apiVersion": "2023-01-31",
              "name": "uami-bootstrap-iss",
              "location": "[parameters('location')]"
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceGroup().id, resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'uami-bootstrap-iss'), 'contributor-bootstrap')]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b24988ac-6180-42a0-ab88-20f7382dd24c')]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'uami-bootstrap-iss'), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'uami-bootstrap-iss')]"
              ]
            },
            {
              "type": "Microsoft.ContainerInstance/containerGroups",
              "apiVersion": "2023-05-01",
              "name": "aci-bootstrap-iss",
              "location": "[parameters('location')]",
              "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                  "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'uami-bootstrap-iss'))]": {}
                }
              },
              "properties": {
                "restartPolicy": "Never",
                "osType": "Linux",
                "containers": [
                  {
                    "name": "bootstrap",
                    "properties": {
                      "image": "[parameters('bootstrapImageUri')]",
                      "environmentVariables": [
                        {
                          "name": "FABRIC_CLIENT_ID",
                          "value": "[parameters('fabricClientId')]"
                        },
                        {
                          "name": "FABRIC_CLIENT_SECRET",
                          "secureValue": "[parameters('fabricClientSecret')]"
                        },
                        {
                          "name": "FABRIC_TENANT_ID",
                          "value": "[parameters('fabricTenantId')]"
                        },
                        {
                          "name": "FABRIC_WORKSPACE_NAME",
                          "value": "[parameters('fabricWorkspaceName')]"
                        },
                        {
                          "name": "CONTAINER_APP_NAME",
                          "value": "[parameters('containerAppName')]"
                        },
                        {
                          "name": "AZURE_RESOURCE_GROUP",
                          "value": "[parameters('resourceGroupName')]"
                        },
                        {
                          "name": "AZURE_SUBSCRIPTION_ID",
                          "value": "[parameters('subscriptionId')]"
                        },
                        {
                          "name": "UAMI_CLIENT_ID",
                          "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'uami-bootstrap-iss'), '2023-01-31').clientId]"
                        },
                        {
                          "name": "ADMIN_EMAIL",
                          "value": "[parameters('adminEmail')]"
                        },
                        {
                          "name": "DEPLOY_PBI_REPORT",
                          "value": "[if(parameters('deployPbiReport'), 'true', 'false')]"
                        },
                        {
                          "name": "DEPLOY_FABRIC_SCRIPT",
                          "value": "[parameters('deployFabricScriptUrl')]"
                        }
                      ],
                      "resources": {
                        "requests": {
                          "cpu": 1,
                          "memoryInGB": "[json('1.5')]"
                        }
                      }
                    }
                  }
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'uami-bootstrap-iss')]",
                "[resourceId('Microsoft.Authorization/roleAssignments', guid(resourceGroup().id, resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'uami-bootstrap-iss'), 'contributor-bootstrap'))]"
              ]
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'container-app')]",
        "[resourceId('Microsoft.Resources/deployments', 'role-assignments')]"
      ]
    }
  ],
  "outputs": {
    "containerAppName": {
      "type": "string",
      "metadata": {
        "description": "Name of the deployed Container App."
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'container-app'), '2025-04-01').outputs.containerAppName.value]"
    },
    "containerImageUri": {
      "type": "string",
      "metadata": {
        "description": "Container image URI deployed."
      },
      "value": "[variables('effectiveImageUri')]"
    },
    "acrLoginServer": {
      "type": "string",
      "metadata": {
        "description": "Container Registry login server."
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'container-registry'), '2025-04-01').outputs.loginServer.value]"
    },
    "fabricIngestionUri": {
      "type": "string",
      "metadata": {
        "description": "Fabric Ingestion URI — set directly by the bootstrap container via az containerapp update."
      },
      "value": "[parameters('fabricIngestionUri')]"
    },
    "fabricWorkspaceId": {
      "type": "string",
      "metadata": {
        "description": "Fabric workspace GUID — resolved asynchronously by the bootstrap container after it runs."
      },
      "value": ""
    }
  }
}